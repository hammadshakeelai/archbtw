#!/usr/bin/bash
# pipes -- draw growing pipes until Ctrl+C. Written for archbtw.

set -u

cols=$(tput cols 2>/dev/null || echo 80)
rows=$(tput lines 2>/dev/null || echo 25)
count=${1:-3}

# Box-drawing glyphs indexed by [previous direction][new direction],
# directions 0=up 1=right 2=down 3=left.
glyphs=(
    "│┌ ┐"
    "┘─┐ "
    " └│┘"
    "└ ┌─"
)
colors=(31 32 33 34 35 36 37 91 92 93 94 95 96)

cleanup() {
    tput cnorm 2>/dev/null
    printf '\e[0m\e[2J\e[H'
    exit 0
}
trap cleanup INT TERM

tput civis 2>/dev/null
printf '\e[2J'

declare -a x y dir color
reset_pipe() {
    x[$1]=$((RANDOM % cols))
    y[$1]=$((RANDOM % rows))
    dir[$1]=$((RANDOM % 4))
    color[$1]=${colors[RANDOM % ${#colors[@]}]}
}
for ((i = 0; i < count; i++)); do reset_pipe "$i"; done

steps=0
while :; do
    for ((i = 0; i < count; i++)); do
        old=${dir[$i]}
        # Mostly go straight; turn left or right now and then.
        if ((RANDOM % 8 == 0)); then
            new=$(((old + (RANDOM % 2 ? 1 : 3)) % 4))
        else
            new=$old
        fi
        glyph=${glyphs[$old]:$new:1}
        [[ $glyph == " " ]] && glyph=${glyphs[$new]:$new:1}
        printf '\e[%d;%dH\e[%sm%s' $((y[i] + 1)) $((x[i] + 1)) "${color[$i]}" "$glyph"

        dir[$i]=$new
        case $new in
            0) y[$i]=$((y[i] - 1)) ;;
            1) x[$i]=$((x[i] + 1)) ;;
            2) y[$i]=$((y[i] + 1)) ;;
            3) x[$i]=$((x[i] - 1)) ;;
        esac
        # Wrap around the screen edges and occasionally change colour.
        ((x[i] < 0)) && x[$i]=$((cols - 1))
        ((x[i] >= cols)) && x[$i]=0
        ((y[i] < 0)) && y[$i]=$((rows - 1))
        ((y[i] >= rows)) && y[$i]=0
        ((RANDOM % 200 == 0)) && color[$i]=${colors[RANDOM % ${#colors[@]}]}
    done
    ((++steps % 2000 == 0)) && printf '\e[2J'
    # A builtin wait rather than `sleep`: forking a process per frame is slow
    # under emulation. Any key quits, as well as Ctrl+C.
    read -rsn1 -t 0.03 _ && cleanup
done
