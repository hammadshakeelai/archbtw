{
  "name": "archbtw",
  "private": true,
  "version": "1.0.0",
  "description": "A real Arch Linux, running in your browser",
  "homepage": "https://hammadshakeelai.github.io/archbtw/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hammadshakeelai/archbtw.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "resolve": "node scripts/resolve.mjs",
    "why": "node scripts/why.mjs",
    "snapshot": "node scripts/snapshot.ts",
    "images": "node scripts/images.ts",
    "screenshots": "node scripts/screenshots.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "astro": "7.3.3",
    "v86": "0.5.460"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
